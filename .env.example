# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# --- Secrets ---
OPENAI_API_KEY=sk-your-openai-key-here
XAI_API_KEY=
GEMINI_API_KEY=
SECRET_KEY=change-me-to-a-long-random-string

# Local Mongo (docker-compose.yml on the same machine):
# MONGODB_URI=mongodb://pa_admin:<PASSWORD>@localhost:27017/?authSource=admin
#
# Synology NAS Mongo (see docs/nas-mongodb-setup.md):
# MONGODB_URI=mongodb://pa_admin:<PASSWORD>@<NAS_IP>:27017/?authSource=admin
# URL-encode special characters in the password (@ -> %40, etc.)
MONGODB_URI=mongodb://pa_admin:change-me@localhost:27017/?authSource=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- Optional overrides ---
# MONGODB_DB_NAME=jarvis_db
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# GROK_MODEL=grok-2-latest
# WHISPER_MODEL=base
